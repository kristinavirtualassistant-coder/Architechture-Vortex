{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profiles authenticated via Firebase Auth",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "preferences": { "type": "object" }
      },
      "required": ["email", "createdAt"]
    },
    "users/{userId}/saved_leads": {
      "title": "Saved Property & Contact Leads",
      "description": "Property intelligence records and owner contacts saved by the agent",
      "type": "object",
      "properties": {
        "contactName": { "type": "string" },
        "phone": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "apn": { "type": "string" },
        "county": { "type": "string" },
        "dispositionCode": { "type": "string" },
        "notes": { "type": "string" },
        "leadScore": { "type": "number" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["contactName", "phone", "savedAt"]
    },
    "users/{userId}/ai_chats": {
      "title": "AI Conversation Threads",
      "description": "Saved multi-turn chat sessions with Gemini Copilot",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "role": { "type": "string" },
        "model": { "type": "string" },
        "messages": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "role", "updatedAt"]
    }
  }
}
